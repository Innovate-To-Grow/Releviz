aws_region                  = "us-west-2"
app_name                    = "releviz"
environment                 = "prod"
ecr_backend_repository      = "releviz-prod-backend"
ecr_frontend_repository     = "releviz-prod-frontend"
# The protected production workflow first applies with manage_dns=false, proves
# the new ALB through TLS for this hostname, then applies the DNS cutover with
# manage_dns=true. Keep local/operator plans DNS-safe by default.
custom_domain               = "releviz.com"
manage_dns                  = false
route53_zone_id             = "replace-with-route53-zone-id"
django_secret_key_arn       = "arn:aws:secretsmanager:us-west-2:123456789012:secret:releviz/prod/django-secret-key"
django_field_encryption_key_arn = "arn:aws:secretsmanager:us-west-2:123456789012:secret:releviz/prod/field-encryption-key"
metrics_bearer_token_arn    = "arn:aws:secretsmanager:us-west-2:123456789012:secret:releviz/prod/metrics-bearer-token"
alarm_action_arns           = ["arn:aws:sns:us-west-2:123456789012:releviz-prod-alerts"]

# Release-specific values are always supplied by the deployment workflow:
# backend_image_tag  = "40-character-git-sha"
# frontend_image_tag = "40-character-git-sha"

# Optional operational integrations:
# sentry_dsn_secret_arn = "arn:aws:secretsmanager:us-west-2:123456789012:secret:releviz/prod/sentry-dsn"
# secret_kms_key_arn    = "arn:aws:kms:us-west-2:123456789012:key/00000000-0000-0000-0000-000000000000"
