{
  "name": "releviz-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "brace-expansion-safe": "npm:brace-expansion@5.0.9",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "espree": "^11.2.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "postcss": "8.5.28",
    "prettier": "^3.9.7",
    "sass": "^1.104.1"
  },
  "overrides": {
    "brace-expansion": "file:./vendor/brace-expansion-compat",
    "postcss": "$postcss",
    "sharp": "0.35.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:amplify": "AMPLIFY_STATIC_EXPORT=1 next build",
    "start": "next start",
    "test": "jest --forceExit",
    "test:coverage": "jest --coverage --ci --forceExit --silent",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
