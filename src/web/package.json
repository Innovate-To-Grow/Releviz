{
  "name": "releviz-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@material/web": "^2.4.1",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "brace-expansion-safe": "npm:brace-expansion@5.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "8.5.23",
    "prettier": "^3.9.5"
  },
  "overrides": {
    "brace-expansion": "file:./vendor/brace-expansion-compat",
    "postcss": "$postcss",
    "sharp": "0.35.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:amplify": "AMPLIFY_STATIC_EXPORT=1 next build",
    "start": "next start",
    "test": "jest --forceExit",
    "test:coverage": "jest --coverage --ci --forceExit --silent",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
