# Local development defaults. This file is a reference; export values in your
# shell before starting Django when you need to override local.py.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=django-insecure-releviz-local-change-me
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
EXTRA_ALLOWED_HOSTS=
PORT=4000

# Optional local encryption and operational endpoints.
DJANGO_FIELD_ENCRYPTION_KEY=
METRICS_BEARER_TOKEN=
APP_LOG_LEVEL=INFO

# Durable-worker defaults.
EMAIL_WORKER_BATCH_SIZE=100
EMAIL_WORKER_CONCURRENCY=10
EMAIL_WORKER_RATE_PER_SECOND=10
EMAIL_WORKER_POLL_SECONDS=1
RESULT_WORKER_BATCH_SIZE=100
RESULT_WORKER_POLL_SECONDS=1
RESULT_SNAPSHOT_LOCK_TIMEOUT_SECONDS=60
RESULT_FAILURE_RETRY_DELAY_SECONDS=30
