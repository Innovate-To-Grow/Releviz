{
  "name": "releviz-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "python3 src/manage.py runserver 0.0.0.0:${PORT:-4000} --settings=config.settings.local",
    "start": "gunicorn config.wsgi:application --chdir src --bind 0.0.0.0:${PORT:-4000}",
    "test": "python3 src/manage.py test --settings=config.settings.test",
    "test:coverage": "coverage run src/manage.py test --settings=config.settings.test && coverage report --fail-under=100 && coverage xml && coverage html",
    "test:db": "python3 src/manage.py test --settings=config.settings.test_postgres",
    "lint": "ruff check src",
    "lint:fix": "ruff check src --fix",
    "format": "ruff format src",
    "format:check": "ruff format --check src"
  }
}
