{
  "name": "releviz-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "src/web",
    "src/api"
  ],
  "devDependencies": {
    "brace-expansion": "file:./src/web/vendor/brace-expansion-compat"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "7.1.1",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.0"
    },
    "postcss": "8.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.0"
  },
  "scripts": {
    "dev": "npm --workspace=releviz-api run dev & npm --workspace=releviz-web run dev",
    "dev:api": "npm --workspace=releviz-api run dev",
    "dev:web": "npm --workspace=releviz-web run dev",
    "test": "npm --workspace=releviz-api run test && npm --workspace=releviz-web run test",
    "test:coverage": "npm --workspace=releviz-api run test:coverage && npm --workspace=releviz-web run test:coverage && npm run test:audit",
    "test:db": "bash scripts/run-db-tests.sh",
    "test:e2e": "bash scripts/run-e2e.sh",
    "test:audit": "python3 scripts/ci/audit-test-surface.py",
    "quality-gate": "bash scripts/quality-gate.sh"
  }
}
